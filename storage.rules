
rules_version = '2';

// Regras de Segurança do Firebase Storage - Versão 2.2
// Permite que usuários autenticados façam upload apenas para suas respectivas pastas.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Caminho: users/{userId}/widgets/{widgetId}/{fileName}
    match /users/{userId}/widgets/{widgetId}/{allPaths=**} {
      
      // Permite leitura pública para exibição nos widgets e landing pages
      allow read: if true;
      
      // Permite escrita se o usuário estiver autenticado e o UID bater com o segmento da pasta
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Bloqueio padrão para segurança
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
