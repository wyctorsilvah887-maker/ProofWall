rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Regras de acesso para ativos de widgets (Logos e Capas)
    // Caminho esperado: users/{userId}/widgets/{widgetId}/{fileName}
    match /users/{userId}/widgets/{widgetId}/{allPaths=**} {
      
      // Permite leitura pública para que as imagens apareçam nos widgets e páginas públicas
      allow read: if true;
      
      // Permite escrita (upload/delete) apenas se o usuário estiver autenticado e for o dono da pasta
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
