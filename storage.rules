rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/widgets/{widgetId}/{allPaths=**} {
      // Permite leitura pública para que as logos e capas apareçam nos widgets e páginas públicas
      allow read: if true;
      
      // Permite escrita apenas se o usuário estiver logado e for o dono da pasta (userId)
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}