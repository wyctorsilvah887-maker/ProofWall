
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para a coleção de avisos globais
    match /announcements/{announcementId} {
      allow read: if true; // Permite que qualquer usuário veja os avisos
      allow write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regras para a coleção de usuários
    match /users/{userId} {
      allow create: if true;
      allow get, list: if true;
      
      allow update: if (request.auth != null && request.auth.uid == userId) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['testimonialsCount', 'googleRedirectCount', 'membershipStatus', 'trialUsed', 'trialStartedAt']) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testimonialsCount', 'googleRedirectCount', 'membershipStatus', 'trialUsed', 'trialStartedAt']));
      
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      match /testimonials/{testimonialId} {
        allow create: if true;
        allow read: if resource.data.status == 'approved';
        allow read, update, delete: if (request.auth != null && request.auth.uid == userId) || 
          (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      }

      match /private_feedbacks/{feedbackId} {
        allow create: if true;
        allow read, update, delete: if (request.auth != null && request.auth.uid == userId);
      }

      match /widgets/{widgetId} {
        allow read: if true;
        allow update: if true;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Regras para Logs de Pagamento (Público apenas para criação via Webhook, Leitura apenas Admin)
    match /payment_events/{eventId} {
      allow create: if true;
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    match /{document=**} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
