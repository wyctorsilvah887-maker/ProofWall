
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite que qualquer pessoa crie um usuário (lead) na coleção users
    match /users/{userId} {
      allow create: if true;
      // Permite que administradores autenticados leiam a lista
      allow read: if request.auth != null;
    }
    
    // Regra padrão: nega tudo o mais
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
