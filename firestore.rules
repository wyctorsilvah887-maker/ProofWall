rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      // Permite que qualquer um se registre (leads e primeiro passo do admin)
      allow create: if true;
      
      // 1. O próprio usuário pode ler e editar seu próprio perfil
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // 2. Administradores podem ler e editar qualquer perfil e listar a coleção
      // Usamos get() de forma segura para verificar a flag no documento do solicitante
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}