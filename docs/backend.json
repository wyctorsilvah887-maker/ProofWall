
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Usuários registrados para acesso antecipado.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nome completo do usuário."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Endereço de e-mail."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação do registro."
        }
      },
      "required": [
        "name",
        "email",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção global de usuários inscritos."
    }
  }
}
