
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuário unificado (Lead ou Admin).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nome completo."
        },
        "companyName": {
          "type": "string",
          "description": "Nome da empresa ou marca."
        },
        "companySlug": {
          "type": "string",
          "description": "Slug único da empresa para URLs."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Endereço de e-mail."
        },
        "googleMapsUrl": {
          "type": "string",
          "description": "Link global do Google Maps da empresa."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Define se o usuário tem privilégios administrativos."
        },
        "membershipStatus": {
          "type": "string",
          "enum": ["gold", "enterprise", "trial", "expired"],
          "description": "Status da assinatura ou nível de membro."
        },
        "trialStartedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data e hora em que o período de teste começou."
        },
        "trialUsed": {
          "type": "boolean",
          "description": "Indica se o usuário já utilizou o período de teste gratuito."
        },
        "testimonialsCount": {
          "type": "integer",
          "description": "Total de depoimentos recebidos (Counter Pattern para performance)."
        },
        "googleRedirectCount": {
          "type": "integer",
          "description": "Total de cliques para o Google Maps (Counter Pattern para performance)."
        },
        "lastMonthCount": {
          "type": "integer",
          "description": "Total de depoimentos no final do mês anterior para comparação de métricas."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação."
        }
      },
      "required": [
        "name",
        "companyName",
        "companySlug",
        "email",
        "isAdmin",
        "createdAt"
      ]
    },
    "PaymentEvent": {
      "title": "PaymentEvent",
      "description": "Log de eventos recebidos via Webhook da Cakto.",
      "type": "object",
      "properties": {
        "externalId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "status": { "type": "string" },
        "productName": { "type": "string" },
        "payload": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Depoimento enviado por um cliente.",
      "type": "object",
      "properties": {
        "userName": {
          "type": "string",
          "description": "Nome do cliente."
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "Endereço de e-mail do cliente."
        },
        "rating": {
          "type": "number",
          "description": "Avaliação de 1 a 5 estrelas."
        },
        "text": {
          "type": "string",
          "description": "Conteúdo do depoimento."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "archived"],
          "description": "Status de moderação."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de envio."
        }
      },
      "required": ["userName", "rating", "text", "status", "createdAt"]
    },
    "Widget": {
      "title": "Widget",
      "description": "Configuração de um widget de prova social.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nome identificador do widget."
        },
        "selectedTestimonialIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lista de IDs de depoimentos selecionados para este widget."
        },
        "themeColor": {
          "type": "string",
          "description": "Cor principal do widget."
        },
        "secondaryColor": {
          "type": "string",
          "description": "Cor secundária ou de fundo do widget."
        },
        "coverImageUrl": {
          "type": "string",
          "description": "URL da imagem de capa da página pública."
        },
        "coverImageHeight": {
          "type": "integer",
          "description": "Altura customizada da capa em porcentagem da tela (vh)."
        },
        "logoUrl": {
          "type": "string",
          "description": "URL da logo da empresa."
        },
        "whatsappEnabled": {
          "type": "boolean",
          "description": "Ativa botão de WhatsApp."
        },
        "whatsappNumber": {
          "type": "string",
          "description": "Número para contato via WhatsApp."
        },
        "googleMapsUrl": {
          "type": "string",
          "description": "Link do Perfil da Empresa no Google Maps."
        },
        "googleRedirectCount": {
          "type": "integer",
          "description": "Total de cliques para o Google Maps neste widget específico."
        },
        "externalSiteUrl": {
          "type": "string",
          "description": "URL do site externo da empresa."
        },
        "layout": {
          "type": "string",
          "enum": ["mural", "carousel", "grid", "popup"],
          "description": "Tipo de layout do widget."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação."
        }
      },
      "required": ["name", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção central de todos os usuários e leads do sistema."
    },
    "/payment_events/{eventId}": {
      "schema": "PaymentEvent",
      "description": "Logs de webhooks da Cakto para auditoria admin."
    },
    "/users/{userId}/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Depoimentos públicos (4-5 estrelas)."
    },
    "/users/{userId}/private_feedbacks/{feedbackId}": {
      "schema": "Testimonial",
      "description": "Feedbacks privados (1-3 estrelas)."
    },
    "/users/{userId}/widgets/{widgetId}": {
      "schema": "Widget",
      "description": "Configurações de widgets de cada usuário."
    }
  }
}
