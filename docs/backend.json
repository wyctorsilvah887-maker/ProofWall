
{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Information captured from potential customers.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The corporate email of the lead."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the lead was captured."
        }
      },
      "required": [
        "email",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/emails/{emailId}": {
      "schema": "Lead",
      "description": "Collection of captured emails from the landing page."
    }
  }
}
