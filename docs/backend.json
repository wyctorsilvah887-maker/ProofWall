
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Usuários registrados para acesso antecipado.",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Nome de usuário escolhido."
        },
        "password": {
          "type": "string",
          "description": "Senha da conta."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação do registro."
        }
      },
      "required": [
        "username",
        "password",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção global de usuários inscritos."
    }
  }
}
