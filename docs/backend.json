{
  "entities": {
    "User": {
      "title": "User",
      "description": "Usuários registrados para acesso antecipado (Leads).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nome completo do usuário."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Endereço de e-mail."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação do registro."
        }
      },
      "required": [
        "name",
        "email",
        "createdAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Perfil administrativo do sistema.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nome do administrador."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "E-mail do administrador."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de registro do admin."
        }
      },
      "required": [
        "name",
        "email",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção global de leads/usuários interessados."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Perfis de administradores do sistema."
    }
  }
}
