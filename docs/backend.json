
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuário unificado (Lead ou Admin).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nome completo."
        },
        "companyName": {
          "type": "string",
          "description": "Nome da empresa ou marca."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Endereço de e-mail."
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Define se o usuário tem privilégios administrativos."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação."
        }
      },
      "required": [
        "name",
        "companyName",
        "email",
        "isAdmin",
        "createdAt"
      ]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Depoimento enviado por um cliente.",
      "type": "object",
      "properties": {
        "userName": {
          "type": "string",
          "description": "Nome do cliente."
        },
        "userEmail": {
          "type": "string",
          "format": "email",
          "description": "E-mail do cliente."
        },
        "rating": {
          "type": "number",
          "description": "Avaliação de 1 a 5 estrelas."
        },
        "text": {
          "type": "string",
          "description": "Conteúdo do depoimento."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "archived"],
          "description": "Status de moderação."
        },
        "companySlug": {
          "type": "string",
          "description": "Slug da empresa destino."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de envio."
        }
      },
      "required": ["userName", "rating", "text", "status", "companySlug", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Coleção central de todos os usuários e leads do sistema."
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Depoimentos coletados dos clientes."
    }
  }
}
